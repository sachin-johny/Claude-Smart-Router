# Secrets for claude-smart-router. Loaded automatically at startup.
# Precedence: real environment variables > `key set` keystore
# (~/.claude-smart-router/) > this .env file. .env is git-ignored —
# keep it out of commits.
#
# Recommended: skip this file entirely and run
#   claude-smart-router key set route
#   claude-smart-router key set classifier
# Keys then live outside every project directory, typed blind.

# GLM key used for the classifier AND every route tier (all-GLM setup)
ROUTE_API_KEY=your_glm_key_here
CLASSIFIER_API_KEY=your_glm_key_here

# If some tiers use a different provider, override them individually —
# per-tier vars beat ROUTE_API_KEY:
# ROUTE_HARD_API_KEY=your_anthropic_key
# ROUTE_SUPER_HARD_API_KEY=your_anthropic_key

# Optional: require Authorization: Bearer <token> on requests to the router
# (equivalent: claude-smart-router key set router)
# ROUTER_TOKEN=some-local-secret
