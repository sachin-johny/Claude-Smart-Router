{
  "port": 8787,
  "host": "127.0.0.1",
  "clarify": true,
  "skipClassifyMinWords": 4,
  "anthropicVersion": "2023-06-01",
  "upstreamTimeoutMs": 120000,
  "maxSessions": 500,
  "maxBodyMb": 20,

  "routerToken": null,

  "tools": {
    "minComplexity": "medium",
    "model": null
  },

  "repoMap": {
    "enabled": true,
    "root": "./",
    "maxTokens": 2000,
    "minComplexity": "medium",
    "ttlMs": 10000,
    "pinnedFiles": [],
    "compactAfter": { "super_hard": 4, "hard": 5, "medium": 6 },
    "writeToFile": null
  },

  "costWeights": {
    "super_easy": 0.05,
    "easy": 0.15,
    "medium": 0.40,
    "hard": 0.70,
    "super_hard": 1.00
  },

  "baseUrl": "https://api.z.ai/api/anthropic",
  "apiKey": "YOUR_GLM_API_KEY",

  "classifier": {
    "model": "glm-4.7-flash"
  },

  "routes": {
    "super_easy": "glm-4.7-flash",
    "easy": "glm-4.7",
    "medium": "glm-5",
    "hard": "glm-5.2",
    "super_hard": "glm-5.2"
  }
}
