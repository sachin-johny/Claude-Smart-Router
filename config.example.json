{
  "port": 8787,
  "host": "127.0.0.1",
  "clarify": true,
  "skipClassifyMinWords": 4,
  "anthropicVersion": "2023-06-01",
  "upstreamTimeoutMs": 120000,
  "maxSessions": 500,
  "maxBodyMb": 20,

  "routerToken": null,

  "tools": {
    "minComplexity": "medium",
    "model": null
  },

  "repoMap": {
    "enabled": true,
    "root": "./",
    "maxTokens": 2000,
    "minComplexity": "medium",
    "ttlMs": 10000,
    "pinnedFiles": [],
    "compactAfter": { "super_hard": 4, "hard": 5, "medium": 6 },
    "writeToFile": null
  },

  "costWeights": {
    "super_easy": 0.05,
    "easy": 0.15,
    "medium": 0.40,
    "hard": 0.70,
    "super_hard": 1.00
  },

  "budgetMax": null,
  "budgetReject": false,

  "credits": {
    "enabled": true,
    "plan": "lite",
    "caps": { "fiveHour": 2000, "weekly": 10000 },
    "weeklyResetAnchor": "2026-08-26T21:17:00+02:00",
    "warnPct": 80,
    "hints": true,
    "peakHint": true,
    "stateFile": "credits-state.json",
    "multipliers": {
      "glm-5.3": { "in": 6.9, "cached": 1.7, "out": 24 },
      "glm-5-turbo": { "in": 5.7, "cached": 1.5, "out": 21 },
      "glm-4.7": { "in": 4.6, "cached": 1.2, "out": 16 }
    }
  },

  "compactHintTurns": 15,
  "classifyCacheTtlMs": 60000,
  "heuristic": true,

  "baseUrl": "https://api.z.ai/api/anthropic",
  "apiKey": "YOUR_GLM_API_KEY",

  "classifier": {
    "model": "glm-4.7-flash",
    "maxRetries": 3
  },

  "routes": {
    "super_easy": "glm-4.7-flash",
    "easy": "glm-4.7",
    "medium": "glm-5",
    "hard": "glm-5.2",
    "super_hard": "glm-5.2"
  }
}
